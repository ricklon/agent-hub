# DigitalOcean deployment environment.
# Copy to .env.do and fill in real values.
# Do NOT commit .env.do — it holds secrets.

# LLM (OpenRouter or any OpenAI-compatible API)
AGENT_HUB_LLM_OPENAI_API_KEY=sk-or-...
AGENT_HUB_LLM_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AGENT_HUB_LLM_OPENAI_MODEL=google/gemma-4-31b-it

# ASR — Moonshine (local, 42MB, no API keys needed)
AGENT_HUB_ASR_DEFAULT_PROVIDER=moonshine
AGENT_HUB_ASR_MOONSHINE_LANGUAGE=en
AGENT_HUB_ASR_MOONSHINE_MODEL_ARCH=tiny

# TTS — Edge (cloud, free) is the default because KittenTTS needs ~4 vCPU to
# keep up with real-time speech; on a 1 vCPU droplet it runs at ~2x slower
# than the audio it produces. KittenTTS is installed and its model is baked
# in, so on a 4 vCPU droplet this is a one-line switch to fully local speech.
AGENT_HUB_TTS_DEFAULT_PROVIDER=edge
AGENT_HUB_TTS_EDGE_VOICE=en-US-AriaNeural
AGENT_HUB_TTS_KITTEN_MODEL=KittenML/kitten-tts-nano-0.8
AGENT_HUB_TTS_KITTEN_VOICE=Luna

# Dashboard auth — the dashboard controls every device, and a droplet has a
# public IP. deploy/cloud-init.sh replaces this with a generated password;
# if you copy this file by hand, set a long random one yourself. The public
# ingress overlay overrides it with an empty value because Cloudflare Access
# authenticates operators and the tunnel leaves no direct dashboard origin.
AGENT_HUB_SERVER_DASHBOARD_USERNAME=admin
AGENT_HUB_SERVER_DASHBOARD_PASSWORD=changeme

# Host allowlist — the droplet's IP and any domain pointing at it.
# Blocks DNS rebinding; see docs/deployment.md.
# Ignored when the public overlay is used: it sets this to the tunnel hostname.
AGENT_HUB_SERVER_ALLOWED_HOSTS=

# ── Public ingress (docker-compose.public.yml) ──────────────────────────────
# Leave these empty for a plain IP deployment. Setting AGENT_HUB_PUBLIC_HOST
# is what makes cloud-init use the public overlay: Caddy terminates TLS for
# devices, a Cloudflare Tunnel carries the dashboard, and 8000/8001/8003 stop
# being publicly reachable.

# Device hostname — serves wss:// voice sessions, image upload, and check-in.
AGENT_HUB_PUBLIC_HOST=

# Dashboard hostname — reached only through the Cloudflare Tunnel. Put
# Cloudflare Access in front of it; it controls every device.
AGENT_HUB_DASHBOARD_HOST=

# Cloudflare Tunnel token. Create the tunnel in the Cloudflare dashboard
# (Zero Trust -> Networks -> Tunnels), add a public hostname routing
# <dashboard host> to http://agent-hub:8001, and paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional origin-side Cloudflare Access identity verification. The team
# domain appears in the Access login URL; the AUD tag is the application's
# Audience value under Access controls -> Applications. Configure both.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=
# Comma-separated verified email addresses that receive the admin role.
# Everyone else provisioned through Access starts as a read-only viewer.
CLOUDFLARE_ACCESS_ADMIN_EMAILS=

# Address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Enrollment token — required here. Empty means auto-registration, which on a
# public droplet lets anyone who finds port 8003 enroll a device.
AGENT_HUB_SERVER_ENROLLMENT_TOKEN=

# Image token — set before enabling camera/image tools.
AGENT_HUB_SERVER_IMAGE_TOKEN=

# LLM spend caps. 0 disables a cap. Checked before every call, so no billable
# request goes out once one is reached; the device speaks a notice instead.
# A local backstop only — keep a credit limit on the OpenRouter key too.
AGENT_HUB_LLM_SPEND_DAILY_LIMIT_USD=5
AGENT_HUB_LLM_SPEND_TOTAL_LIMIT_USD=25
AGENT_HUB_LLM_SPEND_WARN_AT=0.8
